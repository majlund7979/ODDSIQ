// ODDSIQ persistent data model.
//
// The prediction ledger (Prediction) is append-only: migration
// 0002_ledger_immutability installs triggers that reject UPDATE and DELETE.
// Anything learned after a prediction is made (closing price, result) is
// stored in PredictionOutcome, never on the prediction itself.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sport {
  id      String   @id
  name    String
  leagues League[]
}

model League {
  id            String    @id
  sportId       String
  name          String
  country       String
  /// Last time a scheduled run paid for this league's odds (feed leagues only).
  oddsFetchedAt DateTime?
  sport         Sport     @relation(fields: [sportId], references: [id])
  teams         Team[]
  events        Event[]
}

model Team {
  id         String  @id
  leagueId   String
  name       String
  shortName  String
  league     League  @relation(fields: [leagueId], references: [id])
  homeEvents Event[] @relation("home")
  awayEvents Event[] @relation("away")
}

model Bookmaker {
  id          String         @id
  name        String
  margin      Float
  reliability Float
  snapshots   OddsSnapshot[]
  liveOdds    InPlayOdds[]
  predictions Prediction[]
}

model DataSource {
  id         String   @id
  name       String
  kind       String // odds | stats | lineups | injuries
  provider   String
  status     String // ok | degraded | down
  lastSyncAt DateTime
}

model Event {
  id                String         @id
  /// "<feed prefix>:<provider event id>" when the event came from a live feed (null for demo data).
  externalId        String?        @unique
  sportId           String
  leagueId          String
  homeTeamId        String
  awayTeamId        String
  kickoff           DateTime
  status            String // scheduled | live | finished
  homeScore         Int?
  awayScore         Int?
  lineupConfirmedAt DateTime?
  statsFixtures     StatsFixture[]
  league            League         @relation(fields: [leagueId], references: [id])
  homeTeam          Team           @relation("home", fields: [homeTeamId], references: [id])
  awayTeam          Team           @relation("away", fields: [awayTeamId], references: [id])
  markets           Market[]
  news              MarketNews[]
  liveEvents        LiveEvent[]
  scoreUpdates      ScoreUpdate[]

  @@index([kickoff])
  @@index([leagueId, kickoff])
}

model Market {
  id         String      @id
  eventId    String
  type       String // 1X2 | OU25 | BTTS | ML
  name       String
  suspended  Boolean     @default(false)
  event      Event       @relation(fields: [eventId], references: [id])
  selections Selection[]
}

model Selection {
  id          String         @id
  marketId    String
  eventId     String
  name        String
  result      String? // won | lost | void
  market      Market         @relation(fields: [marketId], references: [id])
  snapshots   OddsSnapshot[]
  liveOdds    InPlayOdds[]
  predictions Prediction[]
}

/// One bookmaker price at one moment. The time series behind every chart.
model OddsSnapshot {
  id          BigInt    @id @default(autoincrement())
  selectionId String
  bookmakerId String
  observedAt  DateTime
  odds        Decimal   @db.Decimal(8, 3)
  sourceId    String
  selection   Selection @relation(fields: [selectionId], references: [id])
  bookmaker   Bookmaker @relation(fields: [bookmakerId], references: [id])

  @@index([selectionId, observedAt])
  @@index([bookmakerId, observedAt])
}

/// A bookmaker price observed after kickoff. Kept apart from OddsSnapshot so
/// closing lines and pre-match analytics never see in-play prices.
model InPlayOdds {
  id          BigInt    @id @default(autoincrement())
  selectionId String
  bookmakerId String
  observedAt  DateTime
  odds        Decimal   @db.Decimal(8, 3)
  sourceId    String
  selection   Selection @relation(fields: [selectionId], references: [id])
  bookmaker   Bookmaker @relation(fields: [bookmakerId], references: [id])

  @@index([selectionId, observedAt])
}

/// The score as the odds feed reported it at one ingestion run. The feed gives
/// no match clock or goal times, only the score when asked.
model ScoreUpdate {
  id         BigInt   @id @default(autoincrement())
  eventId    String
  observedAt DateTime
  homeScore  Int
  awayScore  Int
  completed  Boolean
  event      Event    @relation(fields: [eventId], references: [id])

  @@index([eventId, observedAt])
}

/// News that may explain price moves. Shown as context, never as proven cause.
model MarketNews {
  id       BigInt   @id @default(autoincrement())
  eventId  String
  at       DateTime
  kind     String
  text     String
  sourceId String
  event    Event    @relation(fields: [eventId], references: [id])

  @@index([eventId, at])
}

model LiveEvent {
  id          BigInt @id @default(autoincrement())
  eventId     String
  minute      Int
  kind        String // goal | yellow | red | substitution | shot | corner | var
  team        String // home | away
  description String
  modelBefore Float?
  modelAfter  Float?
  event       Event  @relation(fields: [eventId], references: [id])

  @@index([eventId, minute])
}

model ModelVersion {
  id           String       @id // e.g. football-ensemble-v1.4
  family       String
  version      String
  releasedAt   DateTime
  trainingFrom DateTime
  trainingTo   DateTime
  features     String[]
  notes        String
  predictions  Prediction[]
}

/// Immutable ledger entry. UPDATE and DELETE are rejected by database triggers.
model Prediction {
  id             String             @id
  seq            Int                @unique
  createdAt      DateTime
  eventId        String
  marketId       String
  selectionId    String
  modelVersionId String
  probability    Float
  ciLow          Float
  ciHigh         Float
  confidence     Int
  odds           Decimal            @db.Decimal(8, 3)
  bookmakerId    String
  prevHash       String             @db.Char(64)
  hash           String             @unique @db.Char(64)
  selection      Selection          @relation(fields: [selectionId], references: [id])
  modelVersion   ModelVersion       @relation(fields: [modelVersionId], references: [id])
  bookmaker      Bookmaker          @relation(fields: [bookmakerId], references: [id])
  outcome        PredictionOutcome?

  @@index([createdAt])
  @@index([selectionId])
  @@index([modelVersionId, createdAt])
}

/// What happened after a prediction: closing price and result. Written once per prediction.
model PredictionOutcome {
  predictionId           String     @id
  closingOdds            Decimal    @db.Decimal(8, 3)
  closingFairProbability Float
  result                 String? // won | lost | void; null until settled
  settledAt              DateTime?
  prediction             Prediction @relation(fields: [predictionId], references: [id])
}

/// Markets where the scheduled model run produced no prediction. Recorded so gaps are visible.
model MissingPrediction {
  marketId String   @id
  eventId  String
  reason   String
  kickoff  DateTime
}

/// A terminal account. Personal lists use the same compact encodings as the
/// signed-out cookies (src/lib/demo/personal.ts), so they move over on sign-in.
model User {
  id               String         @id
  email            String         @unique
  passwordHash     String
  createdAt        DateTime       @default(now())
  plan             String         @default("free") // free | pro
  planStatus       String? // Stripe subscription status
  planRenewsAt     DateTime?
  stripeCustomerId String?        @unique
  watchlist        String         @default("")
  positions        String         @default("")
  thresholdPp      Int            @default(5)
  /// Name shown in the friends' league; null shows the part of the e-mail before the @.
  displayName      String?
  /// Receives the morning e-mail with the day's top 5.
  morningEmail     Boolean        @default(true)
  sessions         Session[]
  passwordResets   PasswordReset[]
  friendBets       FriendBet[]
  friendCoupons    FriendCoupon[]
  tips             TipPick[]
}

/// Signed-in sessions. The id is the SHA-256 of the cookie token, so a leaked
/// database row cannot be replayed as a cookie.
model Session {
  id        String   @id @db.Char(64)
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// "Glemt kode": one-time links sent by e-mail. The id is the SHA-256 of the token in the link,
/// so the database never holds a usable link. A link works once, for RESET_MINUTES.
model PasswordReset {
  id        String    @id @db.Char(64)
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One run of the odds ingestion job, for the data-source status panel and quota tracking.
model IngestRun {
  id               BigInt    @id @default(autoincrement())
  provider         String
  /// "scheduled" (every six hours) or "live" (only while matches are in play).
  kind             String    @default("scheduled")
  startedAt        DateTime
  finishedAt       DateTime?
  sportKeys        String[]
  events           Int       @default(0)
  snapshots        Int       @default(0)
  results          Int       @default(0)
  creditsUsed      Int?
  creditsRemaining Int?
  error            String?

  @@index([startedAt])
}

/// A finished match from a public results source, used to train and backtest the real model.
/// A pick shown on Dagens bedste bets, recorded the first time it appears so the
/// results board can show how the picks did. Settled when read, from the event's
/// score and the match stats; never edited.
model PickRecord {
  id          BigInt   @id @default(autoincrement())
  createdAt   DateTime
  eventId     String
  kickoff     DateTime
  leagueName  String
  /// openfootball code, for looking up match stats; null outside the model's leagues.
  leagueCode  String?
  home        String
  away        String
  category    String
  outcome     String
  /// Machine-readable bet, e.g. "1X2:home", "OU:over:2.5", "COUNT:corners:over:9.5".
  spec        String
  probability Float
  odds        Float?

  @@unique([eventId, category])
  @@index([kickoff])
}

/// Corners, cards (yellow + red) and fouls per match, from football-data.co.uk.
model MatchStat {
  id      BigInt   @id @default(autoincrement())
  source  String
  league  String // openfootball code, e.g. en.1
  season  String // e.g. 2025-26
  date    DateTime
  home    String
  away    String
  hc      Int?
  ac      Int?
  hcards  Int?
  acards  Int?
  hf      Int?
  af      Int?
  /// Full-time and half-time goals, and the referee's name as the source writes it.
  hg      Int?
  ag      Int?
  hthg    Int?
  htag    Int?
  referee String?

  @@unique([league, date, home, away])
  @@index([league, date])
}

model HistoricalMatch {
  id     BigInt   @id @default(autoincrement())
  source String
  league String // openfootball code, e.g. en.1
  season String // e.g. 2025-26
  date   DateTime
  home   String
  away   String
  hg     Int
  ag     Int

  @@unique([league, date, home, away])
  @@index([league, date])
}

/// Stored walk-forward backtest of a model version on one league.
model ModelBacktest {
  id             BigInt   @id @default(autoincrement())
  modelVersionId String
  league         String
  createdAt      DateTime
  testFrom       DateTime
  testTo         DateTime
  n              Int
  /// Scores per component and benchmark, goals-market scores and calibration bins.
  summary        Json

  @@index([league, createdAt])
}

/// A fixture from the football statistics feed, matched to a feed event when possible.
model StatsFixture {
  /// "<provider>:<provider fixture id>"
  id         String         @id
  provider   String
  leagueId   Int
  eventId    String?
  event      Event?         @relation(fields: [eventId], references: [id])
  kickoff    DateTime
  home       String
  away       String
  status     String // scheduled | live | finished | other
  homeGoals  Int?
  awayGoals  Int?
  referee    String?
  /// The provider's team ids, for the squad statistics.
  homeTeamId Int?
  awayTeamId Int?
  homeXg     Float?
  awayXg     Float?
  /// Per-side shots, shots on target and possession.
  stats      Json?
  syncedAt   DateTime
  lineupsAt  DateTime?
  injuriesAt DateTime?
  statsAt    DateTime?
  lineups    TeamLineup[]
  injuries   InjuryReport[]

  @@index([eventId])
  @@index([leagueId, kickoff])
}

/// A confirmed starting lineup, as published by the statistics feed.
model TeamLineup {
  fixtureId   String
  fixture     StatsFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  side        String // home | away
  team        String
  formation   String?
  coach       String?
  startXI     Json
  substitutes Json
  fetchedAt   DateTime

  @@id([fixtureId, side])
}

/// A player listed as out or doubtful for a fixture. Replaced on each refresh.
model InjuryReport {
  id        BigInt       @id @default(autoincrement())
  fixtureId String
  fixture   StatsFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  side      String
  team      String
  player    String
  status    String // out | doubtful
  reason    String
  fetchedAt DateTime

  @@index([fixtureId])
}

/// Emails the owner (OWNER_EMAIL) has invited. Only these, the owner and
/// ALLOWED_EMAILS can create an account or use the site.
model Friend {
  email   String   @id
  name    String   @default("")
  addedAt DateTime @default(now())
}

/// A bet a friend saved from Dagens bedste bets, for the friends' league.
/// The pick's details are copied from the page's own pick when saved; the
/// result is settled when read, the same way as PickRecord.
model FriendBet {
  id          BigInt   @id @default(autoincrement())
  userId      String
  createdAt   DateTime @default(now())
  eventId     String
  kickoff     DateTime
  leagueName  String
  leagueCode  String?
  home        String
  away        String
  category    String
  outcome     String
  spec        String
  probability Float
  /// The odds the friend got; null when not entered.
  odds        Float?
  /// Stake in kroner.
  stake       Float
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, spec])
  @@index([kickoff])
}

/// A coupon a friend played from "Din kupon": every leg must go home. Legs are copied from the page's own picks.
model FriendCoupon {
  id        BigInt            @id @default(autoincrement())
  userId    String
  createdAt DateTime          @default(now())
  /// Stake in kroner.
  stake     Float
  /// The combined odds the friend got; null when not entered.
  odds      Float?
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  legs      FriendCouponLeg[]

  @@index([userId])
}

model FriendCouponLeg {
  id          BigInt       @id @default(autoincrement())
  couponId    BigInt
  eventId     String
  kickoff     DateTime
  leagueName  String
  leagueCode  String?
  home        String
  away        String
  category    String
  outcome     String
  spec        String
  probability Float
  /// Best odds we showed for the leg; null for bet types without odds.
  odds        Float?
  coupon      FriendCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([kickoff])
}

/// One row per day the morning e-mail went out, so a re-run does not send it twice.
model MorningMail {
  day        String   @id
  sentAt     DateTime @default(now())
  recipients Int
}

/// One user's 1X2 tip on one match in the weekly tipping game (/tips).
/// The tip can change until kickoff; it is settled from the match result when read.
model TipPick {
  id         BigInt   @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId    String
  /// ISO week in Danish time, e.g. "2026-W40".
  week       String
  kickoff    DateTime
  home       String
  away       String
  league     String
  /// football-data.co.uk league code, to settle from the results CSVs when the feed has no score.
  leagueCode String?
  /// home | draw | away
  pick       String
  /// Best odds for the tipped outcome when the tip was made.
  odds       Float?
  /// The model's likeliest outcome for the match when the tip was made.
  modelPick  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, eventId])
  @@index([week])
  @@index([eventId])
}

/// A player's season totals for one team in one league, from the statistics
/// feed's squad endpoint. Replaced on each refresh, for the shots-on-target picks.
model PlayerSeasonStat {
  provider       String
  leagueId       Int
  season         Int
  teamId         Int
  playerId       Int
  name           String
  position       String?
  appearances    Int
  lineups        Int
  minutes        Int
  shotsOn        Int
  shotsTotal     Int
  goals          Int
  assists        Int      @default(0)
  foulsCommitted Int      @default(0)
  foulsDrawn     Int      @default(0)
  injured        Boolean  @default(false)
  fetchedAt      DateTime

  @@id([provider, leagueId, season, teamId, playerId])
  @@index([provider, teamId, season])
}

/// One player's numbers in one of his team's recent matches, for the team search's "last 5 matches".
model PlayerMatchStat {
  provider       String
  fixtureId      String
  teamId         Int
  playerId       Int
  name           String
  kickoff        DateTime
  minutes        Int
  shotsOn        Int
  goals          Int
  assists        Int
  foulsCommitted Int
  foulsDrawn     Int
  fetchedAt      DateTime

  @@id([provider, fixtureId, playerId])
  @@index([provider, teamId, kickoff])
}

/// When a team's squad statistics were last fetched in full.
model PlayerStatsSync {
  /// "<provider>:<league>:<season>:<team>"
  id        String   @id
  fetchedAt DateTime
}

/// API-Football's own view of an upcoming match (/predictions): win percentages and a
/// home-vs-away comparison of form, attack, defence and more. One row per fixture.
model FixturePrediction {
  /// API-Football fixture id
  fixtureId Int      @id
  fetchedAt DateTime
  /// Normalised AfPrediction (src/lib/stats/af-predictions.ts)
  data      Json
}
