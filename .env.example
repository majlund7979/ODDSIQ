# Serve the deterministic demo universe (default). Set to "false" only once a
# licensed odds provider is connected.
DEMO_MODE=true

# Only needed for `npm run db:migrate` / `npm run db:seed`. The app itself runs
# without a database while DEMO_MODE=true.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oddsiq

# --- Phase 9. Everything below is optional; each feature stays off until set. ---

# Accounts (needs DATABASE_URL). Setting OWNER_EMAIL (or ACCOUNTS_ENABLED=true)
# switches on login for the whole site; anyone can create an account.
ACCOUNTS_ENABLED=false
OWNER_EMAIL=
# INVITE_ONLY=true: only the owner, ALLOWED_EMAILS (comma separated) and the
# friends the owner invites on /venner can create an account.
INVITE_ONLY=false
ALLOWED_EMAILS=

# Odds feed: The Odds API (https://the-odds-api.com). Free plan: 500 credits/month.
ODDS_API_KEY=
ODDS_SPORTS=soccer_epl
ODDS_REGIONS=eu
ODDS_MARKETS=h2h
# Required header for GET /api/cron/ingest, /api/cron/live and /api/cron/morning: "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# In-play odds and scores via GET /api/cron/live (call it every few minutes). Costs credits while matches are on.
ODDS_LIVE=off
ODDS_LIVE_INTERVAL_MINUTES=10
ODDS_LIVE_RESERVE=100

# Team news: API-Football (https://www.api-football.com). Lineups, injuries, xG. Optional.
STATS_API_KEY=
# Requests per run (free plan: 100 a day; four runs a day at 20 stay inside it)
STATS_MAX_REQUESTS_PER_RUN=20

# Billing: Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
PRO_PRICE_LABEL=
APP_URL=

# Morning e-mail with today's top 5 (GET /api/cron/morning, run daily by .github/workflows/schedule.yml).
# Resend API key from https://resend.com; without it the e-mail is skipped.
RESEND_API_KEY=
# Sender. Resend's test sender only delivers to the Resend account's own address; verify a domain to send to friends.
MAIL_FROM="Oddsanalyse <onboarding@resend.dev>"
# Extra recipients, comma-separated, on top of signed-in friends who have the e-mail on.
MORNING_EMAIL_TO=
# Links in the e-mails use APP_URL (above). Set it when self-hosting, so reset links never take the request's host.
